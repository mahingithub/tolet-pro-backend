node_modules/
.DS_Store
.env
.env.*

# MongoDB Atlas dumps (mongodump output). These are full copies of production
# data — real user phone numbers, hashed passwords, messages, documents. They
# must never reach a git remote, and they're large binary blobs that would
# bloat the repo permanently even if later deleted.
backup_*/
*.bson.gz
*.bson
dump/

# WhatsApp Web Session (Security Risk)
.wwebjs_auth/
.wwebjs_cache/

# Google Cloud / Firebase service-account keys. A downloaded key JSON contains
# a private key that grants Vertex AI and Firebase access to the whole project;
# this repo deploys to Render straight from git, so one of these committed is a
# published credential. Credentials belong in env vars
# (FIREBASE_SERVICE_ACCOUNT_BASE64, VERTEX_SERVICE_ACCOUNT_BASE64), never in a file here.
*service-account*.json
*serviceaccount*.json
serviceAccountKey*.json
gcp-*.json
*-firebase-adminsdk-*.json
to-let-pro-*.json

# Old and temp files
*.old
*.bak
*.tmp

# Log files
*.log
npm-debug.log*

# Test coverage output
coverage/

# Puppeteer cache
.cache/
.env
.env.*
*.keystore
*.jks
*.p12
*.p8
*.pem
test_*.js
test_*.cjs
test_*.mjs
capacitor.config.*

